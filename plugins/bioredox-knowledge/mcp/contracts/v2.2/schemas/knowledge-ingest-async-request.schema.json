{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bioredox.bio/knowledge/v2.2/knowledge-ingest-async-request.schema.json",
  "title": "knowledge_ingest_async request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_receipt_id",
    "source_sha256",
    "content_type",
    "upload_id",
    "auth"
  ],
  "properties": {
    "schema_version": {
      "const": "2.2.0"
    },
    "source_receipt_id": {
      "type": "string",
      "pattern": "^sr_[A-Za-z0-9_-]{16,128}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content_type": {
      "const": "application/pdf"
    },
    "upload_id": {
      "type": "string",
      "pattern": "^upl_[A-Za-z0-9_-]{16,128}$"
    },
    "auth": {
      "allOf": [
        {
          "$ref": "nip98-auth-contract.schema.json#/$defs/request_authentication"
        },
        {
          "properties": {
            "url": {
              "const": "/v2/knowledge_ingest_async"
            }
          }
        }
      ]
    },
    "replace_document_id": {
      "type": "string",
      "pattern": "^doc_[A-Za-z0-9_-]{16,128}$"
    }
  }
}
